# Copy to .env and fill in. Never commit .env.

# AWS credentials for the read-only source bucket
AWS__ACCESS_KEY_ID=
AWS__SECRET_ACCESS_KEY=
AWS__REGION=us-east-2
AWS__BUCKET_NAME=

# Local lake root (bronze, silver, gold and _meta live here)
LAKE_ROOT=data

# Secret key for PII tokenization in silver. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it changes every token, so keep it stable once silver is built.
PII_HASH_KEY=

# Google Cloud Run deployment (make deploy). Not secrets, but kept per developer.
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_SERVICE=bianque-api
